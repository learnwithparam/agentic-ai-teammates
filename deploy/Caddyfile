# The public names. Each one points at a port that listens on this machine only.
# Point PUBLIC_DOMAIN and the four names below it at this machine before starting the proxy.

{$PUBLIC_DOMAIN} {
	reverse_proxy localhost:8790
}

# Only sign-in is public. The admin console and the master realm answer 404 here: reach them
# over an SSH tunnel to port 8190 instead.
auth.{$PUBLIC_DOMAIN} {
	@signin path /realms/teammates/* /resources/*
	handle @signin {
		reverse_proxy localhost:8190
	}
	respond 404
}

mail.{$PUBLIC_DOMAIN} {
	reverse_proxy localhost:8801
}

drive.{$PUBLIC_DOMAIN} {
	reverse_proxy localhost:8802
}

books.{$PUBLIC_DOMAIN} {
	reverse_proxy localhost:8803
}
