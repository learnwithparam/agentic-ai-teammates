{
  "name": "agentic-ai-teammates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "langfuse:up": "docker compose -f langfuse/docker-compose.yml up -d --wait",
    "lmail": "tsx apps/lmail/main.ts",
    "ldrive": "tsx apps/ldrive/main.ts",
    "quirkbooks": "tsx apps/quirkbooks/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && tsx --test 'scripts/**/*.test.ts' 'src/**/*.test.ts' 'apps/**/*.test.ts' && tsx scripts/check-models.ts && tsx scripts/readable.ts && tsx scripts/plain-english.ts README.md && tsx scripts/check-repo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@langfuse/openai": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@openfga/sdk": "0.9.8",
    "@opentelemetry/sdk-node": "0.223.2",
    "croner": "11.0.1",
    "dotenv": "18.0.10",
    "exa-js": "2.29.0",
    "express": "5.3.0",
    "feedsmith": "3.1.0",
    "jose": "6.2.18",
    "mailparser": "3.15.0",
    "nodemailer": "10.6.1",
    "openai": "7.63.0",
    "openid-client": "6.9.1",
    "pg": "8.23.1",
    "smtp-server": "3.21.7",
    "standardwebhooks": "1.3.0",
    "unpdf": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "pdfkit": "0.21.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "plainEnglish": {
    "grade": 6,
    "longest": 18,
    "average": 12
  }
