    "invoices:run": "tsx data/invoices/run.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && tsx --test 'scripts/**/*.test.ts' 'src/**/*.test.ts' 'apps/**/*.test.ts' 'data/**/*.test.ts' && tsx scripts/check-models.ts && tsx scripts/readable.ts && tsx scripts/plain-english.ts README.md docs/coverage.md && tsx scripts/check-repo.ts && npm --prefix news run check && npm run build",
